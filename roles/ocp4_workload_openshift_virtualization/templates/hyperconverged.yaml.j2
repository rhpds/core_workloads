---
apiVersion: hco.kubevirt.io/v1beta1
kind: HyperConverged
metadata:
  name: kubevirt-hyperconverged
  namespace: openshift-cnv
spec:
{% if ocp4_workload_openshift_virtualization_workload_tolerations | length > 0 %}
  workloads:
    nodePlacement:
      tolerations:
        {{ ocp4_workload_openshift_virtualization_workload_tolerations | to_yaml }}
{% endif %}
{# Only an explicit false defers the import, so workload.yml can set the pvc #}
{# format on the StorageProfile first and enable the import afterwards. #}
{% set _boot_sources = ocp4_workload_openshift_virtualization_boot_sources_snapshot | default(none) %}
{% if _boot_sources is not none and not (_boot_sources | bool) %}
  enableCommonBootImageImport: false
{% else %}
  enableCommonBootImageImport: true
{% endif %}
